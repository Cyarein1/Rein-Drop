# Copy to .env.local and adjust.

# Auth provider for the web app (server-only): dev | entra. Default: dev in development, entra in
# production. "dev" is DEVELOPMENT-ONLY (automatic sign-in as the seeded user); production builds
# don't contain it. See docs/decisions/0013-entra-external-id-auth.md for the tenant setup.
# AUTH_PROVIDER=dev

# Microsoft Entra External ID (only with AUTH_PROVIDER=entra). SECRETS: real values in .env.local
# (untracked) or a secret store - never commit them.
# ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com
# ENTRA_TENANT_ID=
# Web app registration (redirect URI: <APP_BASE_URL>/auth/callback, front-channel logout to /sign-in).
# ENTRA_WEB_CLIENT_ID=
# ENTRA_WEB_CLIENT_SECRET=
# The API app registration's client ID (the web asks for api://<id>/access_as_user).
# ENTRA_API_CLIENT_ID=
# Public origin of this web app.
# APP_BASE_URL=http://localhost:3000
# Encrypts the session cookies: 32+ random characters (e.g. `openssl rand -base64 48`).
# AUTH_SESSION_SECRET=
# Absolute session length; after it users sign in again. Default: 168 (7 days).
# AUTH_SESSION_MAX_AGE_HOURS=168

# Base URL of apps/api, used by server components (not exposed to the browser).
# Optional in development (defaults to http://localhost:4000); required in production.
API_BASE_URL=http://localhost:4000
