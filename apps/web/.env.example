# Copy to .env.local and adjust.

# Auth provider for the web app (server-only). Default in development: dev.
# "dev" is DEVELOPMENT-ONLY (automatic sign-in as the seeded user) and is refused in
# production builds (`next build` / `next start`), which therefore cannot sign in until
# the managed provider is chosen.
# AUTH_PROVIDER=dev

# Base URL of apps/api, used by server components (not exposed to the browser).
# Optional in development (defaults to http://localhost:4000); required in production.
API_BASE_URL=http://localhost:4000
