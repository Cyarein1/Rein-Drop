# Copy to .env (PowerShell: Copy-Item .env.example .env) and adjust.
# Every value is optional in development; the worker validates them at startup
# and exits with a list of problems if any are invalid.

# development | test | production. Default: development.
NODE_ENV=development

# PostgreSQL connection URL. Default outside production matches docker-compose.yml.
# Required when NODE_ENV=production. Holds the local job queue (Job table) too.
DATABASE_URL=postgresql://reindrop:reindrop@localhost:5432/reindrop

# How often the worker logs a heartbeat (ms, integer >= 1000). Default: 60000.
WORKER_HEARTBEAT_MS=60000

# --- Hunt monitoring pipeline ------------------------------------------------
# How often each LIVE hunt is searched per marketplace, in minutes (1-1440).
# Development default: 15. Required in production - the real value depends on the cost model.
# HUNT_POLL_INTERVAL_MINUTES=15

# Scheduler tick (find due hunts, enqueue searches), ms >= 1000. Default: 30000.
# WORKER_SCHEDULER_INTERVAL_MS=30000
# Runner tick (lease and run jobs), ms >= 100. Default: 2000.
# WORKER_RUNNER_INTERVAL_MS=2000
# Jobs leased per runner tick (1-50). Default: 5.
# WORKER_JOBS_PER_TICK=5
# How long a leased job is hidden from other workers, ms >= 5000. Default: 120000.
# WORKER_JOB_LEASE_MS=120000
# Deliveries before a job is dead-lettered (1-20). Default: 5.
# WORKER_JOB_MAX_ATTEMPTS=5
# Result pages fetched per search (1-10). Default: 1 (newest listings first).
# WORKER_SEARCH_MAX_PAGES=1

# Development marketplace sources. Default: normal. Refused when NODE_ENV=production.
# normal | empty | degraded | rate_limited | unavailable | not_configured |
# invalid_response | malformed_payloads
# EBAY_DEV_SCENARIO=normal
# FACEBOOK_DEV_SCENARIO=normal

# --- Deal analysis -----------------------------------------------------------
# AIProvider that analyses matched listings: mock | foundry. Default: mock (deterministic, local).
# Required in production, where mock is refused. foundry is not implemented yet (startup fails).
# AI_PROVIDER=mock
