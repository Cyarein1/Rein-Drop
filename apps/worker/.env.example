# Copy to .env (PowerShell: Copy-Item .env.example .env) and adjust.
# Every value is optional in development; the worker validates them at startup
# and exits with a list of problems if any are invalid.

# development | test | production. Default: development.
NODE_ENV=development

# PostgreSQL connection URL. Default outside production matches docker-compose.yml.
# Required when NODE_ENV=production. Holds the local job queue (Job table) too.
DATABASE_URL=postgresql://reindrop:reindrop@localhost:5432/reindrop

# How often the worker logs a heartbeat (ms, integer >= 1000). Default: 60000.
WORKER_HEARTBEAT_MS=60000

# --- Hunt monitoring pipeline ------------------------------------------------
# How often each LIVE hunt is searched per marketplace, in minutes (1-1440).
# Development default: 15. Required in production - the real value depends on the cost model.
# HUNT_POLL_INTERVAL_MINUTES=15

# Scheduler tick (find due hunts, enqueue searches), ms >= 1000. Default: 30000.
# WORKER_SCHEDULER_INTERVAL_MS=30000
# Runner tick (lease and run jobs), ms >= 100. Default: 2000.
# WORKER_RUNNER_INTERVAL_MS=2000
# Jobs leased per runner tick (1-50). Default: 5.
# WORKER_JOBS_PER_TICK=5
# How long a leased job is hidden from other workers, ms >= 5000. Default: 120000.
# WORKER_JOB_LEASE_MS=120000
# Deliveries before a job is dead-lettered (1-20). Default: 5.
# WORKER_JOB_MAX_ATTEMPTS=5
# Result pages fetched per search (1-10). Default: 1 (newest listings first).
# WORKER_SEARCH_MAX_PAGES=1

# Source health + per-source backoff (decision 0009). A search slower than SLOW_MS marks the
# source degraded; after DOWN_AFTER failures in a row it is down. A failing source cools down for
# BACKOFF_BASE_MS, doubling per failure up to BACKOFF_MAX_MS - its hunts wait instead of retrying.
# WORKER_SEARCH_TIMEOUT_MS=30000
# WORKER_SOURCE_SLOW_MS=5000
# WORKER_SOURCE_DOWN_AFTER=3
# WORKER_SOURCE_BACKOFF_BASE_MS=30000
# WORKER_SOURCE_BACKOFF_MAX_MS=900000
# How often each source's own health check runs (fills in when there were no searches).
# WORKER_HEALTH_PROBE_MS=60000

# Development marketplace sources. Default: normal. Refused when NODE_ENV=production.
# normal | empty | degraded | rate_limited | unavailable | not_configured |
# invalid_response | malformed_payloads
# EBAY_DEV_SCENARIO=normal
# FACEBOOK_DEV_SCENARIO=normal

# --- Real eBay source (eBay Buy > Browse API, decision 0010) -----------------
# dev (default outside production) = the development eBay source; api = the real Browse API.
# Production always uses api. Credentials come from an eBay developer keyset (developer.ebay.com):
# put them in your untracked .env / the host's secret store - NEVER commit them.
# EBAY_SOURCE=dev
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# production | sandbox - must match the keyset. Default: production.
# EBAY_ENVIRONMENT=production
# eBay site, e.g. EBAY_US (default), EBAY_GB, EBAY_AU.
# EBAY_MARKETPLACE_ID=EBAY_US

# --- Facebook data provider (docs/providers/facebook-apify.md) ---------------
# dev (default) = development provider; apify = Apify Marketplace scraper (DEVELOPMENT ONLY -
# terms not approved, D12; refused in production; costs about USD 2.60 per 1,000 results).
# FACEBOOK_SOURCE=dev
# APIFY_TOKEN=
# ISO currency of the searched region (the provider's output has no currency code), e.g. ZAR.
# FACEBOOK_APIFY_CURRENCY=
# FACEBOOK_APIFY_ACTOR=apify~facebook-marketplace-scraper
# FACEBOOK_APIFY_RESULTS_LIMIT=20
# FACEBOOK_APIFY_PRICE_PER_1000_USD=2.60
# FACEBOOK_APIFY_TIMEOUT_SECONDS=240
# Also: slow (6s extra per request) and flaky (every other request fails).
# Simulated latency per request for the development sources (development only):
# EBAY_DEV_LATENCY_MS=0
# FACEBOOK_DEV_LATENCY_MS=0

# --- Deal analysis -----------------------------------------------------------
# AIProvider that analyses matched listings: mock | foundry. Default: mock (deterministic, local).
# Required in production, where mock is refused. foundry = Microsoft Foundry (Azure OpenAI v1 API,
# structured outputs) - see docs/decisions/0012-foundry-ai-provider.md.
# AI_PROVIDER=mock

# Microsoft Foundry (only with AI_PROVIDER=foundry). SECRETS: put real values in your untracked .env
# or a secret store - never commit them.
# Resource endpoint (https://<resource>.openai.azure.com or https://<resource>.services.ai.azure.com).
# FOUNDRY_ENDPOINT=
# FOUNDRY_API_KEY=
# Your deployment name(s) from the Foundry portal - one for every task, or one per task. The model
# must support structured outputs (json_schema, strict).
# FOUNDRY_DEPLOYMENT=
# FOUNDRY_DEPLOYMENT_PRODUCT_EXTRACTION=
# FOUNDRY_DEPLOYMENT_CONDITION_RISK=
# FOUNDRY_DEPLOYMENT_DEAL_EXPLANATION=
# Per-request timeout, retries after the first try, generated-token cap. Defaults: 25000, 1, 1500.
# One analysis must fit WORKER_JOB_LEASE_MS (startup checks it).
# FOUNDRY_TIMEOUT_MS=25000
# FOUNDRY_MAX_RETRIES=1
# FOUNDRY_MAX_OUTPUT_TOKENS=1500
# USD per 1M tokens from YOUR Azure price sheet (both or neither). Without them AI cost shows as unknown.
# FOUNDRY_PRICE_INPUT_PER_1M_USD=
# FOUNDRY_PRICE_OUTPUT_PER_1M_USD=

# --- Notifications -----------------------------------------------------------
# How email deliveries go out: simulator | disabled. Default: simulator (logged as
# "[simulated email] ..." lines and stored as SIMULATED - nothing leaves the machine).
# Required in production, where simulator is refused. No email provider exists yet.
# NOTIFICATION_DELIVERY=simulator

# Push: expo | simulator | none. Default: simulator (every push logged as "[simulated push]").
# expo = Expo Push Service for Expo push tokens (development / store builds; free, no account
# needed unless enhanced push security is on). Development tokens from Expo Go are always
# simulated. Required in production, where simulator is refused.
# PUSH_PROVIDER=simulator
# Only if "enhanced push security" is enabled for the Expo project. Secret - never commit.
# EXPO_ACCESS_TOKEN=
