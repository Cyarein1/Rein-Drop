{
  "name": "worker",
  "version": "0.0.1",
  "private": true,
  "description": "Rein Drop background worker (Nest standalone application context, no HTTP server)",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:int": "vitest run --config ./vitest.config.int.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@rein-drop/ai-core": "workspace:*",
    "@rein-drop/contracts": "workspace:*",
    "@rein-drop/db": "workspace:*",
    "@rein-drop/env": "workspace:*",
    "@rein-drop/marketplace-core": "workspace:*",
    "@rein-drop/matching": "workspace:*",
    "@rein-drop/scoring": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/node": "^24.19.1",
    "oxlint": "^1.87.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
