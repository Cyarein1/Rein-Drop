# Copy to .env (PowerShell: Copy-Item .env.example .env) and adjust.
# Every value is optional in development; the API validates them at startup
# and exits with a list of problems if any are invalid.

# development | test | production. Default: development.
NODE_ENV=development

# HTTP port for the API. Default: 4000.
PORT=4000

# Which auth provider authenticates requests. Default outside production: dev.
# "dev" is DEVELOPMENT-ONLY (seeded user, no passwords, local network only) and the API
# refuses to start with it when NODE_ENV=production. Required in production; the managed
# provider is not chosen yet, so production cannot start until one is added.
AUTH_PROVIDER=dev

# Development marketplace sources (synthetic eBay / Facebook listings). Default: normal.
# One of: normal | empty | degraded | rate_limited | unavailable | not_configured |
#         invalid_response | malformed_payloads
# Use them to see empty, error and degraded states locally. Refused when NODE_ENV=production.
# EBAY_DEV_SCENARIO=normal
# FACEBOOK_DEV_SCENARIO=normal

# --- Real eBay source (eBay Buy > Browse API, decision 0010) -----------------
# dev (default outside production) = the development eBay source; api = the real Browse API.
# Production always uses api. Credentials come from an eBay developer keyset (developer.ebay.com):
# put them in your untracked .env / the host's secret store - NEVER commit them.
# EBAY_SOURCE=dev
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# production | sandbox - must match the keyset. Default: production.
# EBAY_ENVIRONMENT=production
# eBay site, e.g. EBAY_US (default), EBAY_GB, EBAY_AU.
# EBAY_MARKETPLACE_ID=EBAY_US

# --- Facebook data provider (docs/providers/facebook-apify.md) ---------------
# dev (default) = development provider; apify = Apify Marketplace scraper (DEVELOPMENT ONLY -
# terms not approved, D12; refused in production; costs about USD 2.60 per 1,000 results).
# FACEBOOK_SOURCE=dev
# APIFY_TOKEN=
# ISO currency of the searched region (the provider's output has no currency code), e.g. ZAR.
# FACEBOOK_APIFY_CURRENCY=
# FACEBOOK_APIFY_ACTOR=apify~facebook-marketplace-scraper
# FACEBOOK_APIFY_RESULTS_LIMIT=20
# FACEBOOK_APIFY_PRICE_PER_1000_USD=2.60
# FACEBOOK_APIFY_TIMEOUT_SECONDS=240

# PostgreSQL connection URL. Default outside production matches docker-compose.yml.
# Required when NODE_ENV=production. If the DB is down the API still starts and
# GET /health reports "database": "down".
DATABASE_URL=postgresql://reindrop:reindrop@localhost:5432/reindrop
