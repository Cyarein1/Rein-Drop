# Copy to .env (PowerShell: Copy-Item .env.example .env) and adjust.
# Every value is optional in development; the API validates them at startup
# and exits with a list of problems if any are invalid.

# development | test | production. Default: development.
NODE_ENV=development

# HTTP port for the API. Default: 4000.
PORT=4000

# Requests per signed-in user (or anonymous client IP) per minute. Default: 600.
# RATE_LIMIT_PER_MINUTE=600
# Reverse proxies in front of the API whose X-Forwarded-For is trusted (Azure ingress: 1). Default: 0.
# TRUST_PROXY_HOPS=0
# json (one JSON object per line - default in production) | text (default in development).
# LOG_FORMAT=text

# Product events (beta telemetry, docs/telemetry/product-events.md): log (default - one
# "product_event" log line per event) | none. A vendor (PostHog candidate) comes with decision D15.
# PRODUCT_EVENTS_PROVIDER=log

# Which auth provider authenticates requests: dev | entra. Default outside production: dev.
# "dev" is DEVELOPMENT-ONLY (seeded user, no passwords, local network only) and can never be
# enabled when NODE_ENV=production. Production uses "entra" (Microsoft Entra External ID,
# docs/decisions/0013-entra-external-id-auth.md).
AUTH_PROVIDER=dev

# Microsoft Entra External ID (only with AUTH_PROVIDER=entra). Identifiers, not secrets.
# Tenant authority: https://<tenant-subdomain>.ciamlogin.com
# ENTRA_AUTHORITY=
# Directory (tenant) ID (GUID).
# ENTRA_TENANT_ID=
# Application (client) ID of the Rein Drop API app registration = the access-token audience.
# ENTRA_API_CLIENT_ID=
# Delegated scope the API exposes (Expose an API). Default: access_as_user
# ENTRA_REQUIRED_SCOPE=access_as_user

# Web billing (docs/decisions/0014-stripe-web-billing.md): dev | stripe. Default: dev outside
# production (fake confirmation, no card); production requires stripe.
# BILLING_PROVIDER=dev
# Stripe (only with BILLING_PROVIDER=stripe). SECRETS: real values in your untracked .env or a
# secret store - never commit them. Use test-mode keys (sk_test_...) locally.
# STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally: printed by `stripe listen`.
# STRIPE_WEBHOOK_SECRET=
# Prices are NOT in code: map plan codes to Stripe price ids (create the prices in Stripe).
# STRIPE_PRICE_IDS=pro=price_...,ultimate=price_...
# Web app origin - checkout / portal return URLs are built from it.
# WEB_APP_URL=http://localhost:3000

# Development marketplace sources (synthetic eBay / Facebook listings). Default: normal.
# One of: normal | empty | degraded | rate_limited | unavailable | not_configured |
#         invalid_response | malformed_payloads
# Use them to see empty, error and degraded states locally. Refused when NODE_ENV=production.
# EBAY_DEV_SCENARIO=normal
# FACEBOOK_DEV_SCENARIO=normal

# --- Real eBay source (eBay Buy > Browse API, decision 0010) -----------------
# dev (default outside production) = the development eBay source; api = the real Browse API.
# Production always uses api. Credentials come from an eBay developer keyset (developer.ebay.com):
# put them in your untracked .env / the host's secret store - NEVER commit them.
# EBAY_SOURCE=dev
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# production | sandbox - must match the keyset. Default: production.
# EBAY_ENVIRONMENT=production
# eBay site, e.g. EBAY_US (default), EBAY_GB, EBAY_AU.
# EBAY_MARKETPLACE_ID=EBAY_US

# --- Facebook data provider (docs/providers/facebook-apify.md) ---------------
# dev (default) = development provider; apify = Apify Marketplace scraper (DEVELOPMENT ONLY -
# terms not approved, D12; refused in production; costs about USD 2.60 per 1,000 results).
# FACEBOOK_SOURCE=dev
# APIFY_TOKEN=
# ISO currency of the searched region (the provider's output has no currency code), e.g. ZAR.
# FACEBOOK_APIFY_CURRENCY=
# FACEBOOK_APIFY_ACTOR=apify~facebook-marketplace-scraper
# FACEBOOK_APIFY_RESULTS_LIMIT=20
# FACEBOOK_APIFY_PRICE_PER_1000_USD=2.60
# FACEBOOK_APIFY_TIMEOUT_SECONDS=240

# PostgreSQL connection URL. Default outside production matches docker-compose.yml.
# Required when NODE_ENV=production. If the DB is down the API still starts and
# GET /health reports "database": "down".
DATABASE_URL=postgresql://reindrop:reindrop@localhost:5432/reindrop
