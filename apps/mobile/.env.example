# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* values into the JS bundle -
# never put secrets here.

# Base URL of apps/api. "localhost" only works on an emulator/simulator running
# on this machine (Android emulator: use http://10.0.2.2:4000). On a physical
# phone use your computer's LAN IP, e.g. http://192.168.1.50:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
