# Optional. Copy to .env (PowerShell: Copy-Item .env.example .env) only if the default
# does not work for you. Expo inlines EXPO_PUBLIC_* values into the JS bundle -
# never put secrets here. Restart `pnpm --filter mobile start` after changing this file.

# Default in development (no value set): the app uses the address of the computer
# running the Expo dev server - e.g. Metro on 192.168.1.50:8081 -> API at
# http://192.168.1.50:4000. That works for a physical phone on the same Wi-Fi and
# for emulators, with nothing hard-coded.
#
# Set this to override it - required for tunnel mode (`expo start --tunnel`) and for
# any non-development build:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:4000

# API port used by the development default above. Default: 4000.
# EXPO_PUBLIC_API_PORT=4000

# Auth provider: dev | entra. Default: dev in development, entra in release builds (which never
# contain the development provider). Public client IDs only - no secrets on a phone.
# EXPO_PUBLIC_AUTH_PROVIDER=entra
# EXPO_PUBLIC_ENTRA_AUTHORITY=https://<tenant-subdomain>.ciamlogin.com
# EXPO_PUBLIC_ENTRA_TENANT_ID=
# Mobile app registration (public client). Redirect URI: reindrop://auth (development build) -
# Expo Go uses exp://<your-ip>:8081/--/auth, which must be registered too.
# EXPO_PUBLIC_ENTRA_MOBILE_CLIENT_ID=
# EXPO_PUBLIC_ENTRA_API_CLIENT_ID=
# EXPO_PUBLIC_AUTH_SESSION_MAX_AGE_HOURS=168
