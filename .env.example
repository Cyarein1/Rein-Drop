# Root .env is read by docker compose only (docker-compose.yml).
# Copy to .env if you need to change anything - all values below are the defaults.

POSTGRES_USER=reindrop
POSTGRES_PASSWORD=reindrop
POSTGRES_DB=reindrop
# Host port. Change this if 5432 is taken (e.g. a native PostgreSQL install),
# and update DATABASE_URL in apps/api/.env and apps/worker/.env to match.
POSTGRES_PORT=5432
