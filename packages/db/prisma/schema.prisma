// Rein Drop - initial PostgreSQL schema.
//
// Conventions
// - IDs: time-ordered UUIDv7 stored as native uuid.
// - Money: integer minor units (e.g. cents) + ISO-4217 currency code. Never floats.
// - Timestamps: timestamptz(3).
// - Marketplace-specific data never becomes a column on Listing. It stays in
//   RawListing.payload (verbatim source) and Listing.sourceMetadata (extras kept
//   after normalization). Marketplaces are rows, not an enum, so adding one does
//   not require a migration.
// - Fields whose shape is a pending product decision are Json with a TODO, rather
//   than invented columns.
//
// Datasource URL is configured in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums - stable lifecycle / status concepts only
// ---------------------------------------------------------------------------

/// Hunt lifecycle: DRAFT -> LIVE <-> PAUSED; any -> ARCHIVED (never deleted).
enum HuntStatus {
  DRAFT
  LIVE
  PAUSED
  ARCHIVED
}

/// Monitoring priority. MVP: NORMAL only ("Hot Hunt" is a later plan feature).
enum HuntPriority {
  NORMAL
}

/// Append-only Hunt history.
enum HuntEventType {
  CREATED
  EDITED
  ACTIVATED
  PAUSED
  RESUMED
  ARCHIVED
  RESTORED
}

/// Processing state of a raw source record.
enum RawListingStatus {
  PENDING
  NORMALIZED
  FAILED
  SKIPPED
}

/// Availability of a listing on its source marketplace, as last observed.
enum ListingStatus {
  ACTIVE
  SOLD
  ENDED
  REMOVED
  UNKNOWN
}

/// User-facing state of a match between a hunt and a listing.
/// EXPIRED: set by the system when the listing stops matching (sold, price raised, duplicate);
/// it returns to NEW if the listing matches again. DISMISSED ("Ignore") and BOUGHT are the
/// user's decisions and the system never changes them.
enum HuntMatchStatus {
  NEW
  SEEN
  DISMISSED
  EXPIRED
  BOUGHT
}

enum DealAnalysisStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Where a notification is delivered. Mirrors NOTIFICATION_CHANNELS in @rein-drop/contracts.
enum AlertChannel {
  IN_APP
  PUSH
  EMAIL
}

/// One channel's delivery of an Alert.
/// PENDING -> SENT (real provider) | SIMULATED (local simulator) | FAILED (gave up);
/// SKIPPED = never attempted (turned off in preferences, or no provider configured).
enum DeliveryStatus {
  PENDING
  SENT
  SIMULATED
  SKIPPED
  FAILED
}

enum InventoryStatus {
  IN_STOCK
  LISTED
  SOLD
  RETURNED
  WRITTEN_OFF
}

enum CostCategory {
  SHIPPING
  MARKETPLACE_FEE
  PAYMENT_FEE
  REPAIR
  SUPPLIES
  OTHER
}

/// Outcome of the last marketplace search for a hunt.
enum PollStatus {
  SUCCEEDED
  FAILED
}

enum SearchRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Local job queue states (see the Job model).
enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  DEAD
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  displayName  String?
  /// Which AuthProvider identifies this user ("dev" locally; the managed provider is TBD).
  authProvider String?
  /// The provider's stable id for the user (e.g. an OIDC `sub`). Unique per provider.
  authSubject  String?
  /// Region drives display defaults (currency, distance unit). Detected from the device /
  /// browser locale at first sign-in, overridable by the user. Storage stays canonical.
  countryCode  String?  @db.Char(2)
  currency     String?  @db.Char(3)
  /// "km" | "mi" (contract values).
  distanceUnit String?
  /// Preferred language (BCP 47 primary subtag, e.g. "en", "af", "zu"). The UI falls back to
  /// a supported language when this one is not translated yet.
  language     String?
  /// "detected" | "user" - a detected region never overwrites the user's own choice.
  regionSource String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  sellerProfile           SellerProfile?
  hunts                   Hunt[]
  alerts                  Alert[]
  notificationPreferences NotificationPreference[]
  savedDeals              SavedDeal[]
  inventoryItems          InventoryItem[]
  sales                   Sale[]
  costs                   Cost[]
  subscriptions           Subscription[]
  usageEvents             UsageEvent[]

  @@unique([authProvider, authSubject])
}

/// Reseller-specific profile, 1:1 with User. Holds the Seller Snapshot - the five
/// onboarding answers (App Flow Blueprint section 4; contract in @rein-drop/contracts).
/// Answer columns are plain text (not DB enums): the option lists are product copy that
/// may still change (Blueprint section 22), and contracts validate them.
/// TODO(product): location / budget preferences are not specified yet.
model SellerProfile {
  id          String  @id @default(uuid(7)) @db.Uuid
  userId      String  @unique @db.Uuid
  displayName String?

  // Gate before the five questions: "Are you a reseller?" (null = not answered).
  // Only resellers answer Q1-Q5; non-resellers see "coming soon" for now.
  isReseller Boolean?

  // Q1 - What do you usually hunt for?
  huntCategories          String[]  @default([])
  huntCategoriesOther     String?
  // Q2 - Which best describes your reselling right now?
  resellerStage           String?
  // Q3 - Where do you usually source inventory?
  sourcingChannels        String[]  @default([])
  sourcingChannelsOther   String?
  // Q4 - What makes a deal worth moving on for you? Target meaning depends on the criterion:
  // min_profit / max_buy_price -> amount + currency; min_margin -> whole percent.
  dealCriterion           String?
  dealTargetAmountMinor   Int?
  dealTargetCurrency      String?   @db.Char(3)
  dealTargetMarginPercent Int?
  // Q5 - What would you most like Rein Drop to improve?
  improvementGoal         String?
  /// Set when all five questions have been answered.
  snapshotCompletedAt     DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Marketplaces & listings
// ---------------------------------------------------------------------------

/// A listing source. `key` matches MarketplaceId in @rein-drop/marketplace-core.
model Marketplace {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique
  name      String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  huntMarketplaces HuntMarketplace[]
  rawListings      RawListing[]
  listings         Listing[]
  sales            Sale[]
  searchRuns       SearchRun[]
}

/// One executed marketplace search, serving one or more hunts with compatible criteria.
/// Keyed by the queue job, so a retried job updates the same run.
model SearchRun {
  id                  String          @id @default(uuid(7)) @db.Uuid
  /// Queue job / message id that ran it (idempotency key).
  jobId               String          @unique
  marketplaceId       String          @db.Uuid
  provider            String
  /// Stable key of the merged criteria (hunts sharing it were grouped).
  groupKey            String
  /// Merged MarketplaceSearchCriteria actually sent.
  criteria            Json
  huntIds             String[]        @db.Uuid
  status              SearchRunStatus @default(RUNNING)
  attempts            Int             @default(0)
  pagesFetched        Int             @default(0)
  resultCount         Int             @default(0)
  newListingCount     Int             @default(0)
  updatedListingCount Int             @default(0)
  /// Raw records that FAILED or were SKIPPED during normalization.
  unreadableCount     Int             @default(0)
  // Matching outcome for this run's listings across the hunts it served (latest attempt).
  /// (hunt, listing) pairs that match.
  matchedCount        Int             @default(0)
  /// Matches this run created (first time seen for that hunt).
  newMatchCount       Int             @default(0)
  /// (hunt, listing) pairs rejected by a deterministic check.
  rejectedCount       Int             @default(0)
  /// Listings skipped because they duplicate another listing.
  duplicateCount      Int             @default(0)
  /// Rejections per failed check, e.g. { "price": 3, "relevance": 1 }.
  rejectionSummary    Json?
  errorCode           String?
  errorMessage        String?
  startedAt           DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt          DateTime?       @db.Timestamptz(3)

  marketplace Marketplace  @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  rawListings RawListing[]
  huntMatches HuntMatch[]

  @@index([marketplaceId, startedAt])
  @@index([status])
}

/// Verbatim record fetched from a marketplace adapter. Append-only snapshots:
/// the same external listing can be fetched many times.
model RawListing {
  id            String           @id @default(uuid(7)) @db.Uuid
  marketplaceId String           @db.Uuid
  /// Adapter / data provider that fetched it (e.g. "dev"). Only that provider can read `payload`.
  provider      String
  /// The search run that fetched it (null for records from other sources, e.g. refreshes).
  searchRunId   String?          @db.Uuid
  /// The marketplace's own identifier for the listing.
  externalId    String
  /// Unmodified source payload.
  payload       Json
  status        RawListingStatus @default(PENDING)
  /// Why normalization failed or was skipped.
  statusReason  String?
  fetchedAt     DateTime         @default(now()) @db.Timestamptz(3)
  /// Set once normalized into a Listing.
  listingId     String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  listing     Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  searchRun   SearchRun?  @relation(fields: [searchRunId], references: [id], onDelete: SetNull)

  /// A retried search run must not store the same snapshot twice.
  @@unique([searchRunId, marketplaceId, externalId])
  @@index([marketplaceId, externalId])
  @@index([status])
  @@index([listingId])
}

/// Normalized, marketplace-agnostic listing. One row per (marketplace, externalId).
/// Only fields common to every marketplace belong here.
model Listing {
  id             String        @id @default(uuid(7)) @db.Uuid
  marketplaceId  String        @db.Uuid
  externalId     String
  url            String
  title          String
  description    String?
  /// Asking price in minor units; null when the source shows no price.
  priceMinor     Int?
  currency       String?       @db.Char(3)
  /// Source wording, not yet normalized. TODO(marketplace): normalized condition scale.
  conditionText  String?
  /// Source wording. TODO(marketplace): structured location once needed for distance search.
  locationText   String?
  imageUrls      String[]
  status         ListingStatus @default(UNKNOWN)
  /// When the seller listed it, if the source exposes it.
  listedAt       DateTime?     @db.Timestamptz(3)
  firstSeenAt    DateTime      @default(now()) @db.Timestamptz(3)
  lastSeenAt     DateTime      @default(now()) @db.Timestamptz(3)
  /// Marketplace-specific extras retained after normalization (never queried as columns).
  sourceMetadata Json?
  /// Conservative content fingerprint (@rein-drop/matching dedupeKeyFor); null = never deduplicated.
  dedupeKey      String?
  /// Set when this listing is a duplicate of another (the canonical one is matched instead).
  duplicateOfId  String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  duplicateOf    Listing?        @relation("ListingDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates     Listing[]       @relation("ListingDuplicates")
  marketplace    Marketplace     @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)
  rawListings    RawListing[]
  huntMatches    HuntMatch[]
  dealAnalyses   DealAnalysis[]
  savedDeals     SavedDeal[]
  inventoryItems InventoryItem[]

  @@unique([marketplaceId, externalId])
  @@index([status])
  @@index([lastSeenAt])
  @@index([dedupeKey])
  @@index([duplicateOfId])
}

// ---------------------------------------------------------------------------
// Hunts (saved sourcing searches) & matches
// ---------------------------------------------------------------------------

/// A saved sourcing search. Criteria shape is defined in @rein-drop/contracts (hunts.ts).
/// Edits keep the same id; history lives in HuntEvent. Never deleted - archived instead.
model Hunt {
  id       String       @id @default(uuid(7)) @db.Uuid
  userId   String       @db.Uuid
  name     String
  /// The product or a natural-language description of what to find.
  query    String
  status   HuntStatus   @default(DRAFT)
  priority HuntPriority @default(NORMAL)

  /// Free-text place (city / area / postal code) until geocoding exists. Null = no location.
  locationText        String?
  radiusKm            Int?
  /// Accepted listing conditions (contract values); empty = any.
  conditions          String[] @default([])
  /// Max acquisition price in minor units.
  maxPriceMinor       Int?
  /// Currency for maxPriceMinor and targetProfitMinor (one currency per hunt).
  priceCurrency       String?  @db.Char(3)
  /// Optional target: dollar profit (minor units) OR margin (whole percent), never both.
  targetProfitMinor   Int?
  targetMarginPercent Int?
  /// Keywords whose listings are ignored.
  exclusions          String[] @default([])

  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  /// Last criteria edit.
  lastEditedAt DateTime? @db.Timestamptz(3)
  /// First time the hunt went LIVE.
  activatedAt  DateTime? @db.Timestamptz(3)
  pausedAt     DateTime? @db.Timestamptz(3)
  archivedAt   DateTime? @db.Timestamptz(3)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketplaces HuntMarketplace[]
  events       HuntEvent[]
  matches      HuntMatch[]
  alerts       Alert[]

  @@index([userId, status])
}

/// Append-only history of a hunt (creation, criteria edits, lifecycle changes).
model HuntEvent {
  id          String        @id @default(uuid(7)) @db.Uuid
  huntId      String        @db.Uuid
  type        HuntEventType
  fromStatus  HuntStatus?
  toStatus    HuntStatus?
  /// For EDITED: { field: { before, after } } in contract shape.
  changes     Json?
  /// Who caused the event (null for system events).
  actorUserId String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)

  hunt Hunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@index([huntId, createdAt])
}

/// Which marketplaces a hunt searches. Removing a marketplace from a hunt disables the
/// row instead of deleting it, so past matches stay attributable.
model HuntMarketplace {
  huntId        String   @db.Uuid
  marketplaceId String   @db.Uuid
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Polling metadata (written by the worker).
  /// When the scheduler should next search this marketplace for the hunt. Null = as soon as possible.
  nextPollAt          DateTime?   @db.Timestamptz(3)
  /// Last search that finished (successfully or not).
  lastPolledAt        DateTime?   @db.Timestamptz(3)
  lastPollStatus      PollStatus?
  /// MarketplaceError code of the last failure (e.g. RATE_LIMITED).
  lastPollErrorCode   String?
  lastPollError       String?
  /// Failed search attempts since the last success.
  consecutiveFailures Int         @default(0)

  hunt        Hunt        @relation(fields: [huntId], references: [id], onDelete: Cascade)
  marketplace Marketplace @relation(fields: [marketplaceId], references: [id], onDelete: Restrict)

  @@id([huntId, marketplaceId])
  @@index([marketplaceId])
  @@index([isEnabled, nextPollAt])
}

/// A listing that matched a hunt. Separate from Listing (shared across users)
/// and RawListing (source data).
model HuntMatch {
  id               String          @id @default(uuid(7)) @db.Uuid
  huntId           String          @db.Uuid
  listingId        String          @db.Uuid
  status           HuntMatchStatus @default(NEW)
  /// Why the status was last changed by the system (e.g. "not_available", "duplicate").
  statusReason     String?
  /// Every deterministic check with outcome + code (@rein-drop/matching MatchCheck[]).
  reasons          Json            @default("[]")
  /// 0-100 query coverage from the deterministic matcher.
  relevanceScore   Int?
  /// Inputs for the valuation stage: acquisition price, hunt target, (later) resale estimate.
  economics        Json?
  /// @rein-drop/matching MATCHER_VERSION that produced `reasons`.
  matcherVersion   Int             @default(1)
  lastEvaluatedAt  DateTime        @default(now()) @db.Timestamptz(3)
  /// The search run that first produced this match.
  firstSearchRunId String?         @db.Uuid
  matchedAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)

  // The user's decisions on the deal (Deals API).
  /// First time the user opened it (NEW -> SEEN).
  seenAt        DateTime? @db.Timestamptz(3)
  /// When the user chose Ignore (status DISMISSED); cleared if they undo it.
  dismissedAt   DateTime? @db.Timestamptz(3)
  /// Optional free-text reason given with Ignore.
  dismissReason String?
  /// When the user marked it Bought (status BOUGHT; the purchase is the InventoryItem).
  boughtAt      DateTime? @db.Timestamptz(3)

  hunt           Hunt           @relation(fields: [huntId], references: [id], onDelete: Cascade)
  listing        Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  firstSearchRun SearchRun?     @relation(fields: [firstSearchRunId], references: [id], onDelete: SetNull)
  dealAnalyses   DealAnalysis[]
  alerts         Alert[]
  savedDeals     SavedDeal[]
  inventoryItem  InventoryItem?

  @@unique([huntId, listingId])
  @@index([huntId, status])
  @@index([listingId])
}

/// AI evaluation of a listing, optionally in the context of a hunt match.
model DealAnalysis {
  id               String             @id @default(uuid(7)) @db.Uuid
  listingId        String             @db.Uuid
  huntMatchId      String?            @db.Uuid
  status           DealAnalysisStatus @default(PENDING)
  /// AIProvider id that produced it, e.g. "mock" | "foundry" (see @rein-drop/ai-core).
  provider         String
  /// Provider model/deployment name(s), comma-separated when tasks used different models.
  model            String?
  /// Model version(s) as reported by the provider.
  modelVersion     String?
  /// Task prompt / rule-set versions, e.g. "product-extraction@1,condition-risk@1,deal-explanation@1".
  promptVersion    String?
  /// @rein-drop/ai-core AI_SCHEMA_VERSION of `result`.
  schemaVersion    Int?
  /// Per-task metadata: latency, token usage, provider request ids.
  providerMetadata Json?
  /// Hash of the analysis input + versions (ai-core analysisInputKey), to skip unchanged re-analysis.
  inputHash        String?
  durationMs       Int?
  /// CandidateAnalysisResult from @rein-drop/ai-core (product, risk, explanation); validated + grounded.
  result           Json?
  errorMessage     String?

  // Deterministic scoring (@rein-drop/scoring) combined with `result`.
  /// @rein-drop/scoring SCORING_VERSION that produced the fields below.
  scoringVersion Int?
  /// DealEconomics: asking price, known costs, max price / target checks and - only with real
  /// comparable sales - an ESTIMATED upside. Never realized profit (that comes from Sale + Cost).
  economics      Json?
  /// "exceptional" | "strong" | "moderate" | "weak" (@rein-drop/scoring DEAL_STRENGTHS). Text, not a
  /// DB enum: the tiers are a pending product decision. Null when the AI analysis failed.
  strength       String?
  /// "high" | "medium" | "low": how sure Rein Drop is about this assessment. Null when it failed.
  confidence     String?
  /// 0-100 ranking score; bands never overlap across strengths. Excludes freshness.
  score          Int?
  /// Strength / confidence reasons (DealAssessment) and every alert rule outcome (AlertEligibility).
  scoring        Json?
  /// Whether the match was eligible for an alert when this analysis was made.
  alertEligible  Boolean @default(false)
  /// "deal" | "exceptional" when eligible.
  alertKind      String?

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  huntMatch HuntMatch? @relation(fields: [huntMatchId], references: [id], onDelete: SetNull)
  alerts    Alert[]

  /// One analysis per match per distinct input: a retried / repeated job updates it in place.
  @@unique([huntMatchId, inputHash])
  @@index([listingId, createdAt])
  @@index([huntMatchId])
  @@index([inputHash])
  @@index([status])
  @@index([alertEligible, createdAt])
}

// ---------------------------------------------------------------------------
// User engagement
// ---------------------------------------------------------------------------

/// One intended notification to a user (what the in-app inbox lists). Channel-independent: each
/// channel's attempt is a NotificationDelivery. Created at most once per intent via dedupeKey.
model Alert {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @db.Uuid
  /// NOTIFICATION_CATEGORIES in @rein-drop/contracts, e.g. "deal_alerts" | "exceptional_deals".
  category       String
  huntId         String?   @db.Uuid
  huntMatchId    String?   @db.Uuid
  /// The analysis that made the match eligible.
  dealAnalysisId String?   @db.Uuid
  /// At most one alert per intent, e.g. "deal:<huntMatchId>" - a match never alerts twice.
  dedupeKey      String    @unique
  title          String
  body           String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  /// Read in the inbox (or opened from a notification).
  readAt         DateTime? @db.Timestamptz(3)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hunt         Hunt?                  @relation(fields: [huntId], references: [id], onDelete: SetNull)
  huntMatch    HuntMatch?             @relation(fields: [huntMatchId], references: [id], onDelete: SetNull)
  dealAnalysis DealAnalysis?          @relation(fields: [dealAnalysisId], references: [id], onDelete: SetNull)
  deliveries   NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// One channel's attempt to deliver an Alert. PENDING rows are the outbox the worker sends from.
model NotificationDelivery {
  id          String         @id @default(uuid(7)) @db.Uuid
  alertId     String         @db.Uuid
  channel     AlertChannel
  status      DeliveryStatus @default(PENDING)
  /// Who delivered it: "in_app", "simulator", or a provider id once one exists.
  provider    String?
  /// Why it was SKIPPED or FAILED (e.g. "disabled_by_preference", "not_configured").
  reason      String?
  attempts    Int            @default(0)
  /// A worker is sending it until then (concurrency-safe outbox claim).
  lockedUntil DateTime?      @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  sentAt      DateTime?      @db.Timestamptz(3)

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@unique([alertId, channel])
  @@index([status, createdAt])
}

/// A user's explicit choice for one (category, channel). Missing rows use the defaults in
/// @rein-drop/contracts (NOTIFICATION_RULES) - nothing is stored until the user changes something.
model NotificationPreference {
  userId    String       @db.Uuid
  category  String
  channel   AlertChannel
  enabled   Boolean
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, channel])
}

model SavedDeal {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @db.Uuid
  listingId   String   @db.Uuid
  /// The match it was saved from, if any.
  huntMatchId String?  @db.Uuid
  note        String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  huntMatch HuntMatch? @relation(fields: [huntMatchId], references: [id], onDelete: SetNull)

  @@unique([userId, listingId])
}

// ---------------------------------------------------------------------------
// Reselling ledger
// ---------------------------------------------------------------------------

/// An item the user bought to resell. Doubles as the purchase record.
/// TODO(product): quantity/lots - currently one row per physical item.
model InventoryItem {
  id                 String          @id @default(uuid(7)) @db.Uuid
  userId             String          @db.Uuid
  /// Source listing it was bought from, if sourced through Rein Drop.
  listingId          String?         @db.Uuid
  /// The deal (hunt match) marked Bought that created it - at most one item per deal.
  huntMatchId        String?         @unique @db.Uuid
  title              String
  status             InventoryStatus @default(IN_STOCK)
  purchasePriceMinor Int
  currency           String          @db.Char(3)
  purchasedAt        DateTime        @db.Timestamptz(3)
  notes              String?
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  huntMatch HuntMatch? @relation(fields: [huntMatchId], references: [id], onDelete: SetNull)
  sale      Sale?
  costs     Cost[]

  @@index([userId, status])
}

model Sale {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @db.Uuid
  inventoryItemId String   @unique @db.Uuid
  /// Where it sold, when it was one of the known marketplaces.
  marketplaceId   String?  @db.Uuid
  salePriceMinor  Int
  currency        String   @db.Char(3)
  soldAt          DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  marketplace   Marketplace?  @relation(fields: [marketplaceId], references: [id], onDelete: SetNull)
  costs         Cost[]

  @@index([userId, soldAt])
}

/// Additional cost attached to an inventory item and/or a sale.
model Cost {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @db.Uuid
  inventoryItemId String?      @db.Uuid
  saleId          String?      @db.Uuid
  category        CostCategory
  amountMinor     Int
  currency        String       @db.Char(3)
  incurredAt      DateTime     @db.Timestamptz(3)
  note            String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  sale          Sale?          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([userId, incurredAt])
  @@index([inventoryItemId])
  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Plans, entitlements, billing & usage
// ---------------------------------------------------------------------------

/// TODO(billing): prices live with the billing provider (Stripe is the leading candidate, TBD);
/// no price columns until that is decided.
model Plan {
  id                String   @id @default(uuid(7)) @db.Uuid
  code              String   @unique
  name              String
  isActive          Boolean  @default(true)
  /// Seeded for local development only; must never be offered to real users.
  isDevelopmentOnly Boolean  @default(false)
  /// The free plan users get without a subscription.
  isFree            Boolean  @default(false)
  /// Display order on the plan gate.
  sortOrder         Int      @default(0)
  /// False while entitlement limits are placeholders (awaiting cost calculations).
  limitsFinal       Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  entitlements  Entitlement[]
  subscriptions Subscription[]
}

/// A capability or limit granted by a plan. Keys are defined in @rein-drop/contracts
/// (ENTITLEMENT_KEYS); a missing row means "not granted".
model Entitlement {
  id        String   @id @default(uuid(7)) @db.Uuid
  planId    String   @db.Uuid
  /// Stable feature key, also used by UsageEvent.key for metered features.
  key       String
  /// Numeric limit; null means unlimited (or not a metered feature).
  limit     Int?
  /// Non-numeric value (e.g. monitoring priority tier).
  value     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id                     String             @id @default(uuid(7)) @db.Uuid
  userId                 String             @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus
  /// TODO(billing): billing provider name and its subscription id, once chosen.
  provider               String?
  providerSubscriptionId String?            @unique
  currentPeriodStart     DateTime?          @db.Timestamptz(3)
  currentPeriodEnd       DateTime?          @db.Timestamptz(3)
  canceledAt             DateTime?          @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
}

/// Append-only record of metered usage, checked against Entitlement limits.
model UsageEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @db.Uuid
  /// Matches Entitlement.key.
  key            String
  quantity       Int      @default(1)
  /// Optional caller-supplied key to make recording idempotent.
  idempotencyKey String?  @unique
  metadata       Json?
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, key, occurredAt])
}

// ---------------------------------------------------------------------------
// Background jobs
// ---------------------------------------------------------------------------

/// Backing table of the LOCAL job queue (PostgresJobQueue in apps/worker). Replaceable by Azure
/// Storage Queue / Service Bus behind the same JobQueue interface - nothing else reads this table.
model Job {
  id          String    @id @default(uuid(7)) @db.Uuid
  queue       String
  type        String
  payload     Json
  /// Enqueueing the same key twice on a queue is a no-op (idempotent producers).
  dedupeKey   String?
  status      JobStatus @default(QUEUED)
  /// Deliveries so far (incremented when leased, like a message dequeue count).
  attempts    Int       @default(0)
  maxAttempts Int
  /// Not delivered before this time (scheduling and retry backoff).
  runAt       DateTime  @default(now()) @db.Timestamptz(3)
  /// Current lease: only the holder of this token may complete / retry the job.
  lockToken   String?   @db.Uuid
  /// Lease expiry; a RUNNING job past it is delivered again (worker crashed).
  lockedUntil DateTime? @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@unique([queue, dedupeKey])
  @@index([queue, status, runAt])
}
